# Supabase browser-safe settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Never expose these to browser code or commit real values.
# Vercel supplies VERCEL, VERCEL_ENV, VERCEL_DEPLOYMENT_ID and VERCEL_URL automatically.
# They identify/isolate deployments and enable CDN invalidation; do not configure them manually.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_ID=
BUFFER_API_KEY=
BUFFER_CHANNEL_IDS=
AUTOMATION_SECRET=

